{
  "name": "@dsh-external/dsh-upstream-fixes",
  "description": "Compatibility fixes for broken third-party dsh plugins: makes dsh-auto-approval's scoped package references resolve to the published bare-named packages, and shims dsh-sidechain's deep client import onto the public runtime client entry.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "postinstall": "node scripts/install-aliases.mjs",
    "fix-aliases": "node scripts/install-aliases.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "dsh-auto-approval": "^0.1.0",
    "dsh-client-ui-auto-approval": "^0.1.0"
  },
  "license": "BSD-3-Clause"
}
